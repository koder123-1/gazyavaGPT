# Скопируйте в .env и заполните для локального запуска.

# --- обязательно ---
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
AI_API_KEY=sk-or-v1-...

# --- база данных ---
# Без DATABASE_URL бот работает в памяти: всё пропадёт после остановки.
# Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# --- ИИ ---
# openrouter | gemini | openai | coarena
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
# Модель для картинок (должна поддерживать image). Если занята — бот переберёт резервные.
AI_VISION_MODEL=openrouter/free

# Пул моделей и автопереключение. Через запятую или auto (список берётся у провайдера).
# Из этого списка пользователи выбирают модель командой /model (чужие модели не попадут).
# Удобно для Coarena: один ключ, десяток моделей, бот сам меняет их при 429/5xx.
# AI_MODELS=auto
# Отдельный список для фото: нужен, если в каталоге провайдера нет пометки vision.
# AI_VISION_MODELS=
# Ротация моделей: каждая следующая просьба идёт на следующую модель. 0 — только первая.
# AI_MODEL_ROTATE=1
#
# Coarena (бесплатно $5 в день): ключ coa_... с правом inference:write
# AI_PROVIDER=coarena
# AI_API_KEY=coa_...
# AI_MODELS=auto
#
# ReformBoss — OpenAI-совместимый шлюз https://api.reformboss.com/v1
# Ключ можно положить отдельно, тогда он главнее AI_API_KEY:
# AI_PROVIDER=reformboss
# REFORMBOSS_API_KEY=...
# В каталоге ReformBoss есть image/video/tts-модели, поэтому auto для чата плох:
# лучше перечислить рабочие текстовые модели вручную.
# AI_MODEL=deepseek-v4.1-flash-1017
# AI_MODELS=deepseek-v4.1-flash-1017,gpt-6-luna,glm-5.3,grok-4.7
#
# Резервный провайдер на случай дневного лимита или падения основного:
# AI_FALLBACK_PROVIDER=coarena

# Имя бота в ответах и в системном промпте
BOT_NAME=gazyavaGPT
# AI_BASE_URL подставляется автоматически: openrouter.ai, OpenAI или Google.
#
# Gemini: бесплатный ключ из https://aistudio.google.com/app/apikey,
# но Google блокирует запросы из ряда стран ("User location is not supported"),
# поэтому локально он часто не работает — на сервере в ЕС/США работает.
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.8-flash
#
# OpenAI:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini

# Свой системный промпт (необязательно)
# AI_SYSTEM_PROMPT=

# --- язык ---
# Язык интерфейса по умолчанию: ru | uk | be | en.
# При первом /start бот всё равно спрашивает язык и запоминает выбор.
DEFAULT_LANG=ru

# --- поведение ---
# Сколько сообщений в день на пользователя, 0 = без ограничений
DAILY_LIMIT=30
# Сколько последних сообщений диалога держать в контексте, 0 = без памяти
MAX_CONTEXT=12

# --- файлы ---
# Максимальный размер входящего документа, МБ (Telegram отдаёт боту до 20 МБ)
FILE_MAX_MB=10
# Сколько символов текста из файла уходит в модель (экономит контекст и деньги)
FILE_MAX_CHARS=20000
# Сколько первых страниц PDF читать
FILE_MAX_PDF_PAGES=60
# Свой TTF-шрифт для PDF (по умолчанию assets/DejaVuSans.ttf)
# PDF_FONT_PATH=
# Telegram ID админов через запятую (узнать: /me)
# ADMIN_IDS=123456789
# Владелец: полный доступ и управление ролями. Узнать ID: /me
# OWNER_ID=123456789

# --- модерация группы (по умолчанию тексты берутся из config.py) ---
# Приветствие новым участникам; {name} — имя, {bot} — имя бота
# WELCOME_TEXT=
# Текст /rules; {mute} — длительность мута
# RULES_TEXT=
# Больше N сообщений за M секунд → мут на K минут; FLOOD_LIMIT=0 выключает антифлуд
FLOOD_LIMIT=8
FLOOD_WINDOW=10
MUTE_MINUTES=10

# --- группы: обращение и команды ---
# Прозвища, на которые бот отзывается в группе (через запятую, кроме @username)
BOT_ALIASES=gazyava,газява,газик,газировка,газяваgpt,газикgpt
# Команды, которые в группах молчат (их место — только в личке)
GROUP_DISABLED_COMMANDS=buy,terms,paysupport,check,style,lang,tickets,me

# --- антиспам ---
# Ссылки, массовые упоминания, повторы и КАПС удаляются автоматически
ANTISPAM_ENABLED=1
ANTISPAM_LINKS=1
ANTISPAM_MENTIONS=5
ANTISPAM_DUPLICATES=1
ANTISPAM_CAPS=1
# Что делать после STRIKE_LIMIT нарушений: mute | kick | ban | delete
ANTISPAM_ACTION=mute
STRIKE_LIMIT=3
STRIKE_WINDOW=3600

# --- картинки ---
# pollinations — бесплатная генерация без ключа + базовые правки фото локально;
# openrouter — Gemini-картинки через OpenRouter: без геоблокировки Google,
#              работает с тем же ключом, что и чат (нужны кредиты OpenRouter);
# gemini — напрямую Google AI Studio (нужен ключ, Google режет по стране IP);
# openai — AI-генерация и AI-редактирование по IMAGE_API_KEY.
# reformboss — то же через api.reformboss.com (ключ REFORMBOSS_API_KEY).
IMAGE_PROVIDER=pollinations
# Для pollinations: flux. Для openrouter/gemini: google/gemini-nano-banana-2.1.
# Для openai: gpt-image-1. Для reformboss: grok-imagine-image-lite.
IMAGE_MODEL=flux
IMAGE_SIZE=1024
# Куда откатываться, если платный провайдер недоступен: pollinations | none.
# Благодаря этому /imagine работает даже без кредитов.
IMAGE_FALLBACK=pollinations
# Для openrouter можно не задавать: возьмётся AI_API_KEY.
# Для Gemini: https://generativelanguage.googleapis.com/v1beta
# Для OpenAI: https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_BASE_URL=

# --- обязательная подписка ---
# Канал, подписка на который обязательна. Пусто/off — проверка выключена.
# REQUIRED_CHANNEL=@gazyavaGPT
# REQUIRED_CHANNEL_URL=https://t.me/gazyavaGPT
# Гейт в группах: удалять сообщения неподписанных в чатах, где есть бот.
# 0 — проверять подписку только в личке.
GROUP_GATE_ENABLED=1

# --- пополнение запросов за Telegram Stars ---
# 0 — выключить покупку (кнопки и /buy исчезнут)
PAYMENTS_ENABLED=1
# Пары «запросы:звёзды». Меняются и из /admin → Настройки → Тарифы Stars
STAR_PACKAGES=30:15,60:25,100:30
# Сколько запросов давать за 1 звезду при свободной сумме (меняется из /admin)
STAR_RATE=2
# Контакт в тексте /paysupport (необязательно)
# PAY_SUPPORT_CONTACT=@your_username
# Свой текст /paysupport; {contact} подставляется (необязательно)
# PAY_SUPPORT_TEXT=

# --- локально не нужно: бот сам переключится на polling без этого адреса ---
# WEBHOOK_BASE_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=some-long-random-string
# PORT=8080